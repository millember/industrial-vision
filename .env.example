# Имя приложения в Swagger.
APP_NAME=Industrial Vision API
# TCP-порт ноутбука для локального Docker Compose.
API_PORT=8000
# Анализ фото: disabled по умолчанию; mock включает только демонстрационную заглушку.
ANALYSIS_MODE=disabled
# Хранилище новых фото: local или nextcloud. Старые записи сохраняют выбранный backend.
PHOTO_STORAGE=local
# Путь локального хранилища при запуске без Docker; в контейнере используется /app/photos.
PHOTO_ROOT=var/photos
# HTTPS WebDAV-адрес уже созданной закрытой папки Nextcloud.
NEXTCLOUD_WEBDAV_URL=
NEXTCLOUD_USERNAME=
# Пароль приложения Nextcloud, хранить только в закрытом окружении сервера.
NEXTCLOUD_APP_PASSWORD=
